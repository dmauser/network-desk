      "id": "hybrid-health",
      "yaml": "hybrid-health-daily.yaml",
      "nameEnv": "HYBRID_TASK_NAME",
      "defaultName": "NetOps: Hybrid Connectivity Health (Daily)",
      "description": "Part of the NetOps plugin (powered by Network Desk) — daily read-only check of VPN and ExpressRoute gateways, connections, BGP peers and learned/advertised routes; always refreshes the Hybrid Health Live Report and emails only when a critical or high finding is detected.",
      "cronEnv": "HYBRID_CRON",
      "defaultCron": "0 6 * * *",
      "modelEnv": "HYBRID_MODEL_TIER",
      "reportNameEnv": "HYBRID_REPORT_NAME",
      "defaultReportName": "NetOps: Hybrid Health",
      "prompt": "prompts/hybrid-health.txt",
      "emailSubject": "NetOps hybrid connectivity alert — <date>",
      "emailImportance": "High",
      "emailWhen": "critical-high",
