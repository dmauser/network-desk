{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmauser/network-desk/plugins/netops/response-plans/schema.json",
  "title": "NetOps incident response plan spec",
  "description": "Documentation and validation format for Azure SRE Agent incident response plans. Plans are created in the portal (Builder > Incident response plans) or with `azmcp sreagent incidents plans create`; this file is not imported directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "filter", "handler", "alertSignals", "investigation", "remediation", "azureMcp", "citations"],
  "properties": {
    "apiVersion": {"type": "string", "enum": ["netops.network-desk/v1"]},
    "kind": {"type": "string", "enum": ["IncidentResponsePlanSpec"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^netops-[a-z0-9-]+$"},
        "displayName": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "severities", "titleContains"],
      "properties": {
        "platform": {"type": "string", "enum": ["AzureMonitor"]},
        "severities": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["Sev0", "Sev1", "Sev2", "Sev3", "Sev4"]}},
        "titleContains": {"type": "string", "pattern": "^netops-[a-z0-9-]+$"}
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customAgent", "autonomy", "reinvestigationCooldown"],
      "properties": {
        "customAgent": {"type": "string", "enum": ["netops-investigator"]},
        "autonomy": {"type": "string", "enum": ["Review"]},
        "reinvestigationCooldown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "hours"],
          "properties": {
            "enabled": {"type": "boolean"},
            "hours": {"type": "integer", "minimum": 1, "maximum": 24}
          }
        }
      }
    },
    "alertSignals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceType", "metric", "hint"],
        "properties": {
          "resourceType": {"type": "string", "pattern": "^Microsoft\\.Network/[A-Za-z]+$"},
          "metric": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primarySkill", "followupSkills", "steps"],
      "properties": {
        "primarySkill": {"type": "string", "pattern": "^netops-[a-z0-9-]+$"},
        "followupSkills": {"type": "array", "items": {"type": "string", "pattern": "^netops-[a-z0-9-]+$"}},
        "steps": {"type": "array", "minItems": 3, "items": {"type": "string"}}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "note"],
      "properties": {
        "mode": {"type": "string", "enum": ["human-review-only"]},
        "note": {"type": "string"}
      }
    },
    "azureMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "services", "triggerCondition", "agentMode"],
      "properties": {
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "services": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "triggerCondition": {"type": "string"},
        "agentMode": {"type": "string", "enum": ["review"]}
      }
    },
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/"}}
  }
}
