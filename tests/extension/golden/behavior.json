{
  "tools": [
    {
      "name": "cn_capabilities",
      "description": "Returns a structured map of all 20 cloud networking specialists and their skills, plus how to invoke them via cn_role/cn_orchestrate/cn_skill. Use to discover what networking capabilities are available.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "skipPermission": true
    },
    {
      "name": "cn_route",
      "description": "Given a cloud networking query, returns the recommended specialist(s) and the exact cn_role/cn_orchestrate/cn_skill calls to make. Use when unsure which specialist handles a request.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The user's networking query or task description"
          }
        },
        "required": [
          "query"
        ]
      },
      "skipPermission": true
    },
    {
      "name": "cn_role",
      "description": "Load a cloud networking specialist's role definition (persona, workflow, guardrails). Call this first when engaging a specialist. Select the specialist via the `specialist` argument — there are no per-specialist role tools.",
      "parameters": {
        "type": "object",
        "properties": {
          "specialist": {
            "type": "string",
            "enum": [
              "cn_vnet",
              "cn_fw",
              "cn_lb",
              "cn_dns",
              "cn_pl",
              "cn_hyb",
              "cn_nsec",
              "cn_ntsh",
              "cn_vwan",
              "cn_nmon",
              "cn_mcn",
              "cn_price",
              "cn_iac",
              "cn_cnet",
              "cn_cdn",
              "cn_nauto",
              "cn_sase",
              "cn_ncap",
              "cn_ipv6",
              "cn_doc"
            ],
            "description": "The specialist to engage. One of: cn_vnet (VNet/Subnet Architecture); cn_fw (Firewall Engineering); cn_lb (Load Balancing); cn_dns (DNS); cn_pl (Private Link / Endpoints); cn_hyb (Hybrid Connectivity); cn_nsec (Network Security); cn_ntsh (Network Troubleshooting); cn_vwan (Virtual WAN / SD-WAN); cn_nmon (Network Monitoring); cn_mcn (Multi-Cloud Networking); cn_price (Network Pricing); cn_iac (IaC Generator); cn_cnet (Container Networking); cn_cdn (CDN & Edge Networking); cn_nauto (Network Automation & GitOps); cn_sase (SASE / SSE); cn_ncap (Network Capacity Planning); cn_ipv6 (IPv6 Migration); cn_doc (Documentation & Reporting). Bare forms (vnet, fw, …) are also accepted as aliases."
          }
        },
        "required": [
          "specialist"
        ]
      },
      "skipPermission": true
    },
    {
      "name": "cn_orchestrate",
