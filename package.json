{
  "name": "@dmauser/network-desk",
  "version": "2.3.0",
  "description": "Your cloud networking AI team for GitHub Copilot CLI — 11 specialist agents, one install.",
  "type": "module",
  "bin": {
    "network-desk": "./bin/cli.mjs"
  },
  "scripts": {
    "test": "npm run test:extension && npm run test:netops",
    "test:extension": "node --import ./tests/extension/register-stub.mjs --test \"tests/extension/*.test.mjs\"",
    "test:netops": "python -m pytest -q tests/netops evals/netops",
    "build:plugin": "node extensions/network-desk/scripts/build-plugin.mjs",
    "build:netops": "node scripts/netops/build-netops.mjs",
    "check:netops": "node scripts/netops/build-netops.mjs --check"
  },
  "files": [
    "bin/",
    "extensions/network-desk/",
    "plugins/network-desk/",
    ".github/plugin/marketplace.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md"
  ],
  "keywords": [
    "copilot",
    "copilot-cli",
    "networking",
    "network-desk",
    "azure",
    "aws",
    "gcp",
    "firewall",
    "vpn",
    "vnet",
    "load-balancer",
    "dns"
  ],
  "author": "dmauser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmauser/network-desk.git"
  },
  "engines": {
    "node": ">=18"
  }
}
